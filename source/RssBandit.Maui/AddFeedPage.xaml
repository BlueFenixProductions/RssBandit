<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RssBandit.Maui.AddFeedPage"
             Title="Add feed">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Feed URL" FontAttributes="Bold" TextColor="{StaticResource TnFg}" />
            <Entry x:Name="UrlEntry" Placeholder="https://example.com/feed" Keyboard="Url" />

            <Label Text="Name (optional)" FontAttributes="Bold" TextColor="{StaticResource TnFg}" />
            <Entry x:Name="NameEntry" Placeholder="leave blank to use the feed's own title" />

            <Label Text="Category" FontAttributes="Bold" TextColor="{StaticResource TnFg}" />
            <Picker x:Name="CategoryPicker" Title="(choose a section)" />

            <Label Text="…or a new category" FontAttributes="Bold" TextColor="{StaticResource TnFg}" />
            <Entry x:Name="NewCategoryEntry" Placeholder="type a new section name" />

            <Button Text="Add feed" Clicked="OnAdd" Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
