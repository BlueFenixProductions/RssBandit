<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RssBandit.Maui"
             x:Class="RssBandit.Maui.MainPage"
             Title="Subscriptions">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Clicked="OnAddFeed" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,8" RowSpacing="8">

        <Label Grid.Row="0" Text="{Binding Status}"
               FontSize="13" TextColor="{StaticResource TnComment}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}" IsGrouped="True"
                        SelectionMode="Single" SelectionChanged="OnFeedSelected">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="local:FeedCategoryGroup">
                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"
                           TextColor="{StaticResource TnPurple}" Padding="0,14,0,4" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:SubscriptionItemViewModel">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Remove" BackgroundColor="#F7768E" Invoked="OnDeleteFeed" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Grid Padding="6,11" ColumnDefinitions="*,Auto" ColumnSpacing="12" BackgroundColor="#1A1B26">
                            <Label Grid.Column="0" Text="{Binding Title}"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                               HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
