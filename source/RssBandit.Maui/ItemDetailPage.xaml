<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RssBandit.Maui.ItemDetailPage"
             Title="Article">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="PrevButton" Text="◀ Prev" Clicked="OnPrev" />
        <ToolbarItem x:Name="NextButton" Text="Next ▶" Clicked="OnNext" />
    </ContentPage.ToolbarItems>
    <WebView x:Name="ArticleView" BackgroundColor="#1A1B26" />
</ContentPage>
