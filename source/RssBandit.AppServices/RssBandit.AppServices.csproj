<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Portable contracts layer (MAUI Slice 0): pure net10.0 with NO Windows coupling, so it
         can be shared with the MAUI heads. The WinForms-coupled interfaces were split out into
         RssBandit.WinForms.Contracts. WinForms/WPF/win-x86 are opted out via the IsPortableProject
         gate in ..\Directory.Build.props (this project is listed there); the AssertAppServicesPortable
         target below fails the build if that coupling ever returns. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Nullable enabled on the AppServices contracts layer first (beachhead). The UI
         and engine projects stay non-nullable for now; full enablement is a separate
         incremental effort (~8k warnings across RssBandit + NewsComponents). -->
    <Nullable>enable</Nullable>
    <AssemblyOriginatorKeyFile>..\rssbandit.org.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <Title>RSS Bandit Application Services</Title>
    <Description>Interfaces to be used by external components</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\VersionInfo.cs">
      <Link>VersionInfo.cs</Link>
    </Compile>
    <None Include="..\rssbandit.org.snk">
      <Link>rssbandit.org.snk</Link>
    </None>
  </ItemGroup>

  <!-- Self-enforcing portability assertion (MAUI Slice 0). Runs in CI because the RssBandit
       closure build includes this project. Fails the build if AppServices ever regains a
       -windows TFM or enables WinForms/WPF. -->
  <Target Name="AssertAppServicesPortable" BeforeTargets="Build">
    <Error Condition="$(TargetFramework.Contains('windows'))"
           Text="RssBandit.AppServices must stay portable (net10.0, no -windows TFM)." />
    <Error Condition="'$(UseWindowsForms)' == 'true' or '$(UseWPF)' == 'true'"
           Text="RssBandit.AppServices must not enable WinForms/WPF (it is the portable contracts layer)." />
  </Target>
</Project>