<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Portable (MAUI-shareable) engine (MAUI Slice 0b): plain net10.0, no -windows TFM and
             no WinForms/WPF/win-x86 (opted out via the IsPortableProject gate in ..\Directory.Build.props,
             where this project is listed). The only native bits are runtime-Windows-only: the registry
             MIME/SettingStore lookups (Microsoft.Win32.Registry, framework-provided on net10.0) and a
             kernel32 MoveFileEx P/Invoke in FileHelper (compiles without a package). The
             AssertNewsComponentsPortable target
             below fails the build if -windows or WinForms/WPF coupling ever returns. -->
        <TargetFramework>net10.0</TargetFramework>
        <Title>News Components</Title>
        <Description>News Components</Description>
    </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\*.cs" />
    <Compile Update="Resources\ComponentsText.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ComponentsText.resx</DependentUpon>
    </Compile>
    <None Include="Resources\feedListSchema.xsx">
      <DependentUpon>feedListSchema.xsd</DependentUpon>
    </None>
    <EmbeddedResource Update="Resources\ComponentsText.*.resx">
      <SubType>Designer</SubType>
      <DependentUpon>ComponentsText.Resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ComponentsText.resx">
      <SubType>Designer</SubType>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ComponentsText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\feedImportFilters.OCS.xslt" />
    <EmbeddedResource Include="Resources\feedImportFilters.OPML.xslt" />
    <EmbeddedResource Include="Resources\feedImportFilters.SIAM.xslt" />
    <EmbeddedResource Include="Resources\feedListSchema.xsd">
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\rss-0.91.dtd" />
    <EmbeddedResource Include="Resources\xhtml-lat1.ent" />
    <EmbeddedResource Include="Resources\xhtml-special.ent" />
    <EmbeddedResource Include="Resources\xhtml-symbol.ent" />
    <EmbeddedResource Include="Resources\xhtml1-strict.dtd" />
    <EmbeddedResource Include="Resources\xhtml1-transitional.dtd" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RssBandit.AppServices\RssBandit.AppServices.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- SharpZipLib was formerly a transitive dependency of Lucene.Net.Contrib 2.9.4.1; FileHelper.ZipFiles() uses it directly: -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Registry access for MimeType (HKCR MIME lookup) and INewsComponentsConfiguration (HKCU
         SettingStore) is provided by the net10.0 framework itself, so no Microsoft.Win32.Registry
         package is needed (NuGet prunes it; NU1510). The call sites are guarded with
         OperatingSystem.IsWindows() (CA1416); the WinForms head runs on Windows. -->
  </ItemGroup>

  <!-- Self-enforcing portability assertion (MAUI Slice 0b, mirrors AssertAppServicesPortable). Runs
       in CI because the RssBandit closure build includes this project. Fails the build if the engine
       ever regains a -windows TFM or enables WinForms/WPF. -->
  <Target Name="AssertNewsComponentsPortable" BeforeTargets="Build">
    <Error Condition="$(TargetFramework.Contains('windows'))"
           Text="NewsComponents must stay portable (net10.0, no -windows TFM)." />
    <Error Condition="'$(UseWindowsForms)' == 'true' or '$(UseWPF)' == 'true'"
           Text="NewsComponents must not enable WinForms/WPF (it is the portable engine)." />
  </Target>
</Project>