<Project>

  <PropertyGroup>
    <Authors>Dare Obasanjo,Torsten Rendelmann,Claire Novotny</Authors>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageIconUrl>https://raw.githubusercontent.com/RssBandit/RssBandit/master/source/RssBandit.Package/Assets/app.png</PackageIconUrl>
    <PackageProjectUrl>https://github.com/RssBandit/RssBandit</PackageProjectUrl>
    <PackageLicenseUrl>https://raw.githubusercontent.com/RssBandit/RssBandit/master/LICENSE</PackageLicenseUrl>
    <Company>www.rssbandit.org</Company>
    <Copyright>© 2003-2021 by www.rssbandit.org</Copyright>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- WFO1000 (WinForms designer-serialization analyzer, error by default since .NET 9) is
         suppressed for now: the legacy custom controls need per-property attributes (Phase B/C). -->
    <NoWarn>1701;1702;1705;1591;NU1701</NoWarn>

    <IsLegacyProject>$(MSBuildProjectName.Equals('RssBandit'))</IsLegacyProject>
    <IsPackageProject>$(MSBuildProjectName.Contains('.Package'))</IsPackageProject>
    <LangVersion>preview</LangVersion>

    <!-- Portable (MAUI-shareable) projects build as plain net10.0: no WinForms/WPF/win-x86,
         so they can be referenced by the future MAUI heads. To make another project portable
         (MAUI Slice 0b/D add NewsComponents / RssBandit.ViewModels), append one more `or` clause. -->
    <IsPortableProject Condition="'$(MSBuildProjectName)' == 'RssBandit.AppServices'">true</IsPortableProject>

    <UseWPF Condition="'$(IsPortableProject)' != 'true'">true</UseWPF>
    <UseWindowsForms Condition="'$(IsPortableProject)' != 'true'">true</UseWindowsForms>
    <RuntimeIdentifiers Condition="'$(IsPortableProject)' != 'true'">win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.9.50" PrivateAssets="all" />
  </ItemGroup>

</Project>
