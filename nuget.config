<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet config. The machine's global %APPDATA%\NuGet\NuGet.Config uses a
     restrictive packageSourceMapping (explicit allow-list, no wildcard) that blocks the
     .NET MAUI workload feed and the Microsoft.Maui.* packages. RssBandit's only source is
     nuget.org, so a permissive wildcard mapping over nuget.org is strictly more permissive
     than the inherited config (same single source) and unblocks the MAUI head + workload.
     Mirrors the proven PostXING setup on this machine. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
